{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "slack-handler/**/*.ts",
    "resource-operator/**/*.ts",
    "outlook-sync/**/*.ts",
    "outlook-auth/**/*.ts",
    "sfn-trigger/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
