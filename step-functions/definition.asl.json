{
  "Comment": "EC2/RDS 起動停止自動化 State Machine",
  "StartAt": "DetermineAction",
  "States": {
    "DetermineAction": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.action",
          "StringEquals": "start",
          "Next": "StartEC2"
        },
        {
          "Variable": "$.action",
          "StringEquals": "stop",
          "Next": "StopRDS"
        }
      ],
      "Default": "NotifyError"
    },

    "StartEC2": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "start_ec2",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.operationResult",
      "Next": "WaitEC2Start",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "WaitEC2Start": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "CheckEC2Running"
    },
    "CheckEC2Running": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_ec2",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "start",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsEC2Running",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsEC2Running": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "StartRDS"
        }
      ],
      "Default": "WaitEC2Start"
    },

    "StartRDS": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "start_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.operationResult",
      "Next": "WaitRDSStart",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "WaitRDSStart": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckRDSAvailable"
    },
    "CheckRDSAvailable": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "start",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsRDSAvailable",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsRDSAvailable": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "NotifyComplete"
        }
      ],
      "Default": "WaitRDSStart"
    },

    "StopRDS": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "stop_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.operationResult",
      "Next": "WaitRDSStop",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "WaitRDSStop": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckRDSStopped"
    },
    "CheckRDSStopped": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "stop",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsRDSStopped",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsRDSStopped": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "StopEC2"
        }
      ],
      "Default": "WaitRDSStop"
    },

    "StopEC2": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "stop_ec2",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.operationResult",
      "Next": "WaitEC2Stop",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "WaitEC2Stop": {
      "Type": "Wait",
      "Seconds": 30,
      "Next": "CheckEC2Stopped"
    },
    "CheckEC2Stopped": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_ec2",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "stop",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsEC2Stopped",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsEC2Stopped": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "NotifyComplete"
        }
      ],
      "Default": "WaitEC2Stop"
    },

    "NotifyComplete": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "End": true
    },

    "HandleError": {
      "Type": "Pass",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId",
        "error.$": "States.Format('Step Functions execution failed: {}', $.operationResult)"
      },
      "Next": "NotifyError"
    },
    "NotifyError": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId",
        "error": "処理中にエラーが発生しました"
      },
      "End": true
    }
  }
}
