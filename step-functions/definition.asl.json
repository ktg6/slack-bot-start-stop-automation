{
  "Comment": "EC2/RDS 起動停止自動化 State Machine",
  "StartAt": "DetermineAction",
  "States": {
    "DetermineAction": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.action",
          "StringEquals": "start",
          "Next": "NotifyStarted"
        },
        {
          "Variable": "$.action",
          "StringEquals": "stop",
          "Next": "NotifyStarted"
        }
      ],
      "Default": "NotifyError"
    },

    "NotifyStarted": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "notify_start",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "Next": "RouteAction",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "RouteAction": {
      "Type": "Choice",
      "Choices": [
        { "Variable": "$.action", "StringEquals": "start", "Next": "ParallelStart" },
        { "Variable": "$.action", "StringEquals": "stop", "Next": "ParallelStop" }
      ],
      "Default": "NotifyError"
    },

    "ParallelStart": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "StartEC2InParallel",
          "States": {
            "StartEC2InParallel": {
              "Type": "Task",
              "Resource": "${ResourceOperatorArn}",
              "Parameters": {
                "operation": "start_ec2",
                "ec2InstanceIds.$": "$.ec2InstanceIds",
                "rdsInstanceId.$": "$.rdsInstanceId",
                "action.$": "$.action",
                "environment.$": "$.environment",
                "userId.$": "$.userId"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "StartRDSInParallel",
          "States": {
            "StartRDSInParallel": {
              "Type": "Task",
              "Resource": "${ResourceOperatorArn}",
              "Parameters": {
                "operation": "start_rds",
                "ec2InstanceIds.$": "$.ec2InstanceIds",
                "rdsInstanceId.$": "$.rdsInstanceId",
                "action.$": "$.action",
                "environment.$": "$.environment",
                "userId.$": "$.userId"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallelResult",
      "Next": "WaitRDSStart",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },

    "ParallelStop": {
      "Type": "Parallel",
      "Branches": [
        {
          "StartAt": "StopEC2InParallel",
          "States": {
            "StopEC2InParallel": {
              "Type": "Task",
              "Resource": "${ResourceOperatorArn}",
              "Parameters": {
                "operation": "stop_ec2",
                "ec2InstanceIds.$": "$.ec2InstanceIds",
                "rdsInstanceId.$": "$.rdsInstanceId",
                "action.$": "$.action",
                "environment.$": "$.environment",
                "userId.$": "$.userId"
              },
              "End": true
            }
          }
        },
        {
          "StartAt": "StopRDSInParallel",
          "States": {
            "StopRDSInParallel": {
              "Type": "Task",
              "Resource": "${ResourceOperatorArn}",
              "Parameters": {
                "operation": "stop_rds",
                "ec2InstanceIds.$": "$.ec2InstanceIds",
                "rdsInstanceId.$": "$.rdsInstanceId",
                "action.$": "$.action",
                "environment.$": "$.environment",
                "userId.$": "$.userId"
              },
              "End": true
            }
          }
        }
      ],
      "ResultPath": "$.parallelResult",
      "Next": "WaitRDSStop",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },

    "WaitRDSStart": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckRDSAvailable"
    },
    "CheckRDSAvailable": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "start",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsRDSAvailable",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsRDSAvailable": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "NotifyComplete"
        }
      ],
      "Default": "WaitRDSStart"
    },

    "WaitRDSStop": {
      "Type": "Wait",
      "Seconds": 60,
      "Next": "CheckRDSStopped"
    },
    "CheckRDSStopped": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "check_rds",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action": "stop",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "ResultPath": "$.checkResult",
      "Next": "IsRDSStopped",
      "Catch": [{ "ErrorEquals": ["States.ALL"], "Next": "HandleError" }]
    },
    "IsRDSStopped": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.checkResult.ready",
          "BooleanEquals": true,
          "Next": "NotifyComplete"
        }
      ],
      "Default": "WaitRDSStop"
    },

    "NotifyComplete": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId"
      },
      "End": true
    },

    "HandleError": {
      "Type": "Pass",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId",
        "error.$": "States.Format('Step Functions execution failed: {}', $.operationResult)"
      },
      "Next": "NotifyError"
    },
    "NotifyError": {
      "Type": "Task",
      "Resource": "${ResourceOperatorArn}",
      "Parameters": {
        "operation": "notify",
        "ec2InstanceIds.$": "$.ec2InstanceIds",
        "rdsInstanceId.$": "$.rdsInstanceId",
        "action.$": "$.action",
        "environment.$": "$.environment",
        "userId.$": "$.userId",
        "error": "処理中にエラーが発生しました"
      },
      "End": true
    }
  }
}
